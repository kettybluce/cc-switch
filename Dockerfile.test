# syntax=docker/dockerfile:1
# Backend fixture / proxy self-test image.
# Ubuntu 22.04 + the same GTK / WebKit / SSL packages as .github/workflows/ci.yml.
# Compiles src-tauri cargo tests. Does NOT run the Tauri GUI.
# SCHEMA stays 18. Isolated CC_SWITCH_TEST_HOME at runtime (see compose).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_TARGET_DIR=/app/target \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1 \
    CC_SWITCH_TEST_HOME=/tmp/cc-switch-test-home

WORKDIR /app

# --- system deps (match CI Linux job, with webkit/soup fallbacks) ---
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        pkg-config \
        libssl-dev \
        libgtk-3-dev \
        librsvg2-dev \
        libayatana-appindicator3-dev \
    && (apt-get install -y --no-install-recommends libwebkit2gtk-4.1-dev \
        || apt-get install -y --no-install-recommends libwebkit2gtk-4.0-dev) \
    && (apt-get install -y --no-install-recommends libsoup-3.0-dev \
        || apt-get install -y --no-install-recommends libsoup2.4-dev) \
    && rm -rf /var/lib/apt/lists/*

# --- Rust toolchain from rust-toolchain.toml (layer-cached) ---
COPY rust-toolchain.toml /app/rust-toolchain.toml
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain none \
    && channel="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)" \
    && rustup toolchain install "${channel}" --profile minimal --component rustfmt,clippy \
    && rustup default "${channel}" \
    && rustc --version \
    && cargo --version

# --- cargo fetch + dummy compile so crate deps stay cached ---
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock /app/src-tauri/
COPY src-tauri/patches /app/src-tauri/patches
COPY src-tauri/build.rs /app/src-tauri/build.rs
COPY src-tauri/tauri.conf.json src-tauri/tauri.windows.conf.json /app/src-tauri/
COPY src-tauri/capabilities /app/src-tauri/capabilities
COPY src-tauri/icons /app/src-tauri/icons
COPY src-tauri/common-controls.manifest /app/src-tauri/common-controls.manifest
RUN mkdir -p /app/dist /app/src-tauri/src \
    && printf 'fn main() {}\n' > /app/src-tauri/src/main.rs \
    && printf '// docker dep-cache placeholder\n' > /app/src-tauri/src/lib.rs \
    && cargo fetch --locked --manifest-path src-tauri/Cargo.toml \
    && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib --no-run

# --- real source; prebuild the default Linux fixture/proxy test ---
COPY src-tauri /app/src-tauri
RUN mkdir -p /app/dist /tmp/cc-switch-test-home \
    && cargo test --locked --manifest-path src-tauri/Cargo.toml \
        --test proxy_projection_linux --no-run

# Entrypoint last so script-only edits do not rebuild cargo artifacts.
COPY scripts/docker-backend-self-test.sh /usr/local/bin/docker-backend-self-test.sh
RUN chmod +x /usr/local/bin/docker-backend-self-test.sh

ENTRYPOINT ["/usr/local/bin/docker-backend-self-test.sh"]
