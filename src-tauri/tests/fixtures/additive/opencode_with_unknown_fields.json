{
  "$schema": "https://opencode.ai/config.json",
  "theme": "keep-me",
  "model": "keep-model",
  "customTopLevel": "keep-me",
  "provider": {
    "fixture-oc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fixture OpenCode",
      "options": {
        "baseURL": "https://api.fixture.example/v1",
        "apiKey": "oc-live-key",
        "setCacheKey": true
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": { "context": 128000, "output": 16384 }
        }
      },
      "futureVendorFlag": true
    }
  }
}
