 /// 处理 /v1/chat/completions 请求（OpenAI Chat Completions API - Codex CLI）
+/// Resolve the logical app that a request arriving on the shared Claude/Codex
+/// listen actually belongs to.
+///
+/// Pi projects its own `models.json` onto the shared listen and tags every
+/// request with `x-cc-switch-app: pi`. Without this, a Pi request is treated as
+/// Codex when it is forwarded, so the routing bookkeeping — failover chain,
+/// circuit-breaker key, usage attribution and the per-app model mapping — is
+/// keyed on the wrong app. When two Pi providers expose the same model id
+/// (e.g. `gpt-6-astra` on both ZeroAPI and a CPA card) that mismatch is what
+/// surfaces as a routing error.
+///
+/// Returns `(app_type, tag)` for the forwarder.
+///
+/// NOTE: the *service* string (`app_type_str`, i.e. `"codex"` / `"claude"`) must
+/// NOT be replaced with `"pi"`. `ProviderRouter::select_pi_providers` matches the
+/// Pi catalog against the **listen** app via `pi_api_matches_listen_app`, which
+/// only understands "claude" / "codex" / "gemini"; passing "pi" filters out
+/// every candidate and yields `NoProvidersConfigured` (503 未配置供应商).
+/// Usage attribution to `pi` already happens inside `RequestContext::new` via
+/// `usage_app_type_from_headers`.
+///
+/// Missing or unknown header values keep the original app so existing Claude /
+/// Codex / GrokBuild clients are unaffected.
+fn resolve_shared_listen_app(
+    headers: &axum::http::HeaderMap,
+    default_app: AppType,
+    default_tag: &'static str,
+) -> (AppType, &'static str) {
+    if crate::pi_config::request_is_pi_client(headers) {
+        (AppType::Pi, "Pi")
+    } else {
+        (default_app, default_tag)
+    }
+}
