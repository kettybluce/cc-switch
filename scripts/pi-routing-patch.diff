+    /// 回归测试：Pi 与 Codex 共用同一条监听，「切换同名模型导致路由异常」的根因
+    /// 是 Pi 请求被当作 Codex 转发。这里锁定 app 识别行为。
+    ///
+    /// 注意：服务串（app_type_str）不参与本函数——它必须保持 listen app
+    /// ("codex")，否则 select_pi_providers 的 pi_api_matches_listen_app 会
+    /// 过滤掉全部候选而返回 503 未配置供应商。
+    #[test]
+    fn shared_listen_app_follows_pi_header() {
+        let mut pi = axum::http::HeaderMap::new();
+        pi.insert("x-cc-switch-app", "pi".parse().unwrap());
+
+        // Pi 标记存在 → 转发时按 Pi 处理（大小写不敏感）
+        assert_eq!(
+            resolve_shared_listen_app(&pi, AppType::Codex, "Codex"),
+            (AppType::Pi, "Pi")
+        );
+        let mut pi_upper = axum::http::HeaderMap::new();
+        pi_upper.insert("x-cc-switch-app", "PI".parse().unwrap());
+        assert_eq!(
+            resolve_shared_listen_app(&pi_upper, AppType::Codex, "Codex"),
+            (AppType::Pi, "Pi")
+        );
+
+        // 缺失 / 未知取值 → 保持原 app，老客户端行为不变
+        let empty = axum::http::HeaderMap::new();
+        assert_eq!(
+            resolve_shared_listen_app(&empty, AppType::Codex, "Codex"),
+            (AppType::Codex, "Codex")
+        );
+        let mut other = axum::http::HeaderMap::new();
+        other.insert("x-cc-switch-app", "codex".parse().unwrap());
+        assert_eq!(
+            resolve_shared_listen_app(&other, AppType::Codex, "Codex"),
+            (AppType::Codex, "Codex")
+        );
+
+        // GrokBuild 入口同样支持 Pi 标记，且不带标记时保持 GrokBuild
+        assert_eq!(
+            resolve_shared_listen_app(&pi, AppType::GrokBuild, "Grok Build"),
+            (AppType::Pi, "Pi")
+        );
+        assert_eq!(
+            resolve_shared_listen_app(&empty, AppType::GrokBuild, "Grok Build"),
+            (AppType::GrokBuild, "Grok Build")
+        );
+    }
+
+    /// 锁定服务串必须保持 listen app：pi_api_matches_listen_app 只认
+    /// claude / codex / gemini，传 "pi" 会让 Pi 目录全部落选。
+    #[test]
+    fn pi_listen_app_never_passes_the_pi_service_string() {
+        use crate::pi_config::pi_api_matches_listen_app;
+        // "pi" 不是合法的 listen app → 任何 api 都匹配不上
+        assert!(!pi_api_matches_listen_app(Some("openai-completions"), "pi"));
+        assert!(!pi_api_matches_listen_app(Some("openai-responses"), "pi"));
+        // codex listen 才是 Pi 的 openai-* 卡片该匹配的
+        assert!(pi_api_matches_listen_app(
+            Some("openai-completions"),
+            "codex"
+        ));
+        assert!(pi_api_matches_listen_app(Some("openai-responses"), "codex"));
+    }
